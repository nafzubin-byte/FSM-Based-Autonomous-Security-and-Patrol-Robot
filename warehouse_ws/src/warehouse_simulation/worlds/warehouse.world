    <model name="red_obstacle_1"><static>true</static><pose>-7.0 1.0 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>1.2 1.2 1.0</size></box></geometry></collision><visual name="vis"><geometry><box><size>1.2 1.2 1.0</size></box></geometry><material><ambient>0.8 0.1 0.1 1</ambient></material></visual></link></model>
    <model name="red_obstacle_2"><static>true</static><pose>-4.0 6.0 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry></collision><visual name="vis"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry><material><ambient>0.8 0.1 0.1 1</ambient></material></visual></link></model>
