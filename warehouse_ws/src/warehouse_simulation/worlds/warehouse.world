      <link name="table"><pose>0.5 -0.5 0.4 0 0 0</pose><collision name="col"><geometry><box><size>1.0 1.5 0.8</size></box></geometry></collision><visual name="vis"><geometry><box><size>1.0 1.5 0.8</size></box></geometry><material><ambient>0.6 0.3 0.1 1</ambient></material></visual></link>
