    </model>
    
    <!-- Security Office -->
    <model name="security_office"><static>true</static><pose>6.0 -10.6 0 0 0 0</pose>
      <link name="sec_wall_left"><pose>-1.5 0 1 0 0 0</pose><collision name="col"><geometry><box><size>0.2 3.2 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 3.2 2</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual></link>
      <link name="sec_wall_right"><pose>1.5 0 1 0 0 0</pose><collision name="col"><geometry><box><size>0.2 3.2 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 3.2 2</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual></link>
