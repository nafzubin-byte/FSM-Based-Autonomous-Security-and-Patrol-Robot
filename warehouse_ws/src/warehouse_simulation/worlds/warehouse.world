    <model name="yellow_obstacle_top"><static>true</static><pose>0 5.5 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>1.5 1.5 1.0</size></box></geometry></collision><visual name="vis"><geometry><box><size>1.5 1.5 1.0</size></box></geometry><material><ambient>1.0 0.9 0.1 1</ambient></material></visual></link></model>
    <model name="yellow_obstacle_bottom"><static>true</static><pose>0 -5.0 0.5 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>1.5 1.5 1.0</size></box></geometry></collision><visual name="vis"><geometry><box><size>1.5 1.5 1.0</size></box></geometry><material><ambient>1.0 0.9 0.1 1</ambient></material></visual></link></model>
